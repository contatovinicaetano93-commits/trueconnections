# Neon Postgres (copy to .env.local — never commit real credentials)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Vercel Blob (Ruach video uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# E-mail (recuperação de senha) — https://resend.com
# Plano free: 1 domínio. Verifique trueconnections.com.br no Resend (DNS).
# Enquanto o domínio não estiver verificado, use onboarding@resend.dev.
RESEND_API_KEY="re_..."
EMAIL_FROM="True Connection <onboarding@resend.dev>"

# Sentry (erros em produção) — projeto javascript-nextjs-7u
NEXT_PUBLIC_SENTRY_DSN="https://...@o....ingest.us.sentry.io/..."
SENTRY_DSN="https://...@o....ingest.us.sentry.io/..."
# Opcional: upload de source maps no build
# SENTRY_AUTH_TOKEN="sntrys_..."
# SENTRY_ORG="imobi-hl"
# SENTRY_PROJECT="javascript-nextjs-7u"
